{
	"name": "@cohub/desktop",
	"private": true,
  "version": "0.3.0-dev2.14",
	"description": "Cohub Dev2 for macOS",
	"author": "Cohub",
	"type": "module",
	"main": "build/main.js",
	"scripts": {
		"build:node": "esbuild ../local-relay/node/index.mjs --bundle --platform=node --format=esm --target=node22 --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=resources/relay-node.mjs",
		"build:runtime": "node scripts/prepare-runtime.mjs",
		"build:client": "tsc -p tsconfig.json && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=build/preload.cjs",
		"build": "pnpm build:node && pnpm build:runtime && pnpm build:client",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"release:dev2": "node --use-env-proxy scripts/publish-dev2-release.mjs",
		"package:dir": "ulimit -n 65536 && pnpm build && electron-builder --dir --mac --arm64",
		"package": "ulimit -n 65536 && pnpm build && electron-builder --mac dmg --arm64",
		"test": "node --test src/**/*.test.ts"
	},
	"dependencies": {
		"ws": "8.21.1"
	},
	"devDependencies": {
		"@types/node": "26.4.0",
		"electron": "44.1.1",
		"electron-builder": "26.15.3",
		"esbuild": "0.27.4",
		"typescript": "7.0.2"
	},
	"build": {
		"appId": "cc.atou.cohub.dev2",
		"productName": "Cohub Dev2",
		"asar": true,
		"directories": {
			"output": "release"
		},
		"files": [
			"build/**/*",
			"package.json",
			"!node_modules/**/*"
		],
		"extraResources": [
			{ "from": "assets/Cohub.icns", "to": "icon.icns" },
			{
				"from": "resources",
				"to": ".",
				"filter": [
					"relay-node.mjs",
					"runtime.tar",
					"runtime-manifest.json",
					"runtime-files.json"
				]
			}
		],
		"mac": {
			"minimumSystemVersion": "13.0",
			"category": "public.app-category.developer-tools",
			"target": ["dmg"],
			"identity": "-",
			"icon": "assets/Cohub.icns",
			"extendInfo": {
				"LSUIElement": true
			},
			"entitlements": "assets/entitlements.mac.plist",
			"entitlementsInherit": "assets/entitlements.mac.plist",
			"hardenedRuntime": true,
			"gatekeeperAssess": false
		},
		"dmg": {
			"artifactName": "Cohub-Dev2-${version}-${arch}.${ext}"
		}
	}
}
