{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/.svelte-kit",
			"!**/node_modules",
			"!**/dist",
			"!**/.wrangler",
			"!src/lib/paraglide"
		]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"rules": {
			"style": {
				"useConst": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["src/lib/resource-kit/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["$lib/**", "$app/**", "$env/**"],
										"message": "resource-kit is shared with the resource Apps: use relative, $messages or package imports."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
