# Generated by `pnpm local:setup`. Keep deploy/local-mode/.env private.
COHUB_LOCAL_DATA_DIR=/Users/you/.cohub-local-mode
POSTGRES_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
MINIO_ROOT_USER=cohub-local
MINIO_ROOT_PASSWORD=replace-me
APP_ENCRYPTION_KEY=replace-me
WORKER_SECRET=replace-me

LOCAL_POSTGRES_PORT=54329
LOCAL_REDIS_PORT=6380
LOCAL_MINIO_PORT=9000
LOCAL_MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgresql://cohub:replace-me@127.0.0.1:54329/cohub
REDIS_URL=redis://:replace-me@127.0.0.1:6380
BULLMQ_REDIS_URL=redis://:replace-me@127.0.0.1:6380
COHUB_NODE_ORIGIN=local
ENV=prod
NODE_ENV=production
SESSIONS_NAMESPACE=cohub-local
API_BASE_URL=http://127.0.0.1:8787
INTERNAL_API_BASE_URL=http://127.0.0.1:8787
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:4173
PUBLIC_API_ORIGIN=http://127.0.0.1:8787
PUBLIC_GATEWAY_ORIGIN=ws://127.0.0.1:8788/ws
# Optional private-first Local Mode route served inside your tailnet.
PUBLIC_LOCAL_PRIVATE_ORIGIN=
PUBLIC_COHUB_LOCAL_MODE=true
PUBLIC_LOCAL_RELAY_ENABLED=false
PUBLIC_LOCAL_RELAY_BASE_PATH=/relay
PUBLIC_LOCAL_RELAY_NODE_ID=mac-mini
PUBLIC_COHUB_ENV=prod
PUBLIC_CLOUD_API_ORIGIN=https://api.cohub.live
PUBLIC_CLOUD_GATEWAY_ORIGIN=wss://gateway.cohub.live/ws
# Optional Cloudflare relay. The node token is read from the macOS Keychain,
# never from this file in production.
COHUB_LOCAL_RELAY_URL=
COHUB_LOCAL_RELAY_NODE_ID=mac-mini
COHUB_LOCAL_RELAY_KEYCHAIN_SERVICE=Cohub Local Mode Relay Node
# Required when PUBLIC_LOCAL_PRIVATE_ORIGIN is set. Tailscale Serve injects
# this identity on its loopback proxy path.
COHUB_LOCAL_TAILSCALE_HOST=
COHUB_LOCAL_OWNER_EMAIL=

TURN_OBJECT_S3_ENDPOINT=http://127.0.0.1:9000
TURN_OBJECT_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
TURN_OBJECT_S3_REGION=us-east-1
TURN_OBJECT_S3_BUCKET=cohub-sessions
TURN_OBJECT_S3_ACCESS_KEY_ID=cohub-local
TURN_OBJECT_S3_SECRET_ACCESS_KEY=replace-me
TURN_OBJECT_CDN_BASE_URL=http://127.0.0.1:9000/cohub-sessions
PUBLIC_ASSET_OSS_ENDPOINT=http://127.0.0.1:9000
PUBLIC_ASSET_OSS_PUBLIC_ENDPOINT=http://127.0.0.1:9000
PUBLIC_ASSET_OSS_REGION=us-east-1
PUBLIC_ASSET_OSS_BUCKET=cohub-assets
PUBLIC_ASSET_OSS_ACCESS_KEY_ID=cohub-local
PUBLIC_ASSET_OSS_SECRET_ACCESS_KEY=replace-me
PUBLIC_ASSET_CDN_BASE_URL=http://127.0.0.1:9000/cohub-assets
CHAT_ATTACHMENT_S3_BUCKET=cohub-assets
CHAT_ATTACHMENT_PUBLIC_BASE_URL=http://127.0.0.1:9000/cohub-assets
SPACE_UPLOAD_S3_BUCKET=cohub-assets
CHECKPOINT_ASSET_OSS_ENDPOINT=http://127.0.0.1:9000
CHECKPOINT_ASSET_OSS_PUBLIC_ENDPOINT=http://127.0.0.1:9000
CHECKPOINT_ASSET_OSS_REGION=us-east-1
CHECKPOINT_ASSET_OSS_BUCKET=cohub-assets
CHECKPOINT_ASSET_OSS_ACCESS_KEY_ID=cohub-local
CHECKPOINT_ASSET_OSS_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true

SPACE_STORAGE_ROOT=/Users/you/.cohub-local-mode/spaces
WORKSPACE_ROOT=/Users/you/.cohub-local-mode/spaces
SPACE_SYSTEM_ROOT=/Users/you/.cohub-local-mode/system
CHECKPOINT_CACHE_ROOT=/Users/you/.cohub-local-mode/checkpoints
SESSIONS_DIR=/Users/you/.cohub-local-mode/sessions
PLATFORM_CONFIG_ROOT=/Users/you/.cohub-local-mode/configs
LOCAL_GIT_ROOT=/Users/you/.cohub-local-mode/git
SPACE_STORAGE_SUBPATH=spaces
CHECKPOINT_CACHE_SUBPATH=checkpoints

# Optional Pi model. Leave empty until a compatible key is available.
LOCAL_PI_PROVIDER=openai
LOCAL_PI_MODEL=gpt-5.1-codex-mini
LOCAL_PI_BASE_URL=https://api.openai.com/v1
LOCAL_PI_API_KEY=
