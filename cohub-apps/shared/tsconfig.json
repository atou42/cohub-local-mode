{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "types": ["node", "svelte", "vite/client"],
    "paths": {
      "$kit/*": ["../../apps/web/src/lib/resource-kit/*"],
      "$messages": ["../../apps/web/src/lib/paraglide/messages.js"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
